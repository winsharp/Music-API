VITE_DISCOGS_BASE_URL=https://api.discogs.com
VITE_DISCOGS_TOKEN=your_discogs_personal_access_token

# Register an app at https://www.discogs.com/settings/developers to get these.
# Used for the client-side OAuth 1.0a "Connect Discogs Account" flow.
# NOTE: the consumer secret ships in the browser bundle with this setup —
# acceptable for a training project, not for production (proxy through a
# backend instead if this app ever needs to be hardened).
VITE_DISCOGS_CONSUMER_KEY=your_discogs_consumer_key
VITE_DISCOGS_CONSUMER_SECRET=your_discogs_consumer_secret
